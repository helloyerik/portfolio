{
  "name": "portfolio-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:9999": "vite --port 9999 --host 127.0.0.1 --strictPort",
    "dev:keep": "bash scripts/vite-keep.sh start",
    "dev:stop": "bash scripts/vite-keep.sh stop",
    "dev:status": "bash scripts/vite-keep.sh status",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "optimize:images": "node scripts/optimize-images.mjs",
    "predeploy": "npm run optimize:images",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "@yerik/yedesign-system": "https://codeload.github.com/helloyerik/yedesign-system/tar.gz/refs/tags/v1.0.4",
    "agentation": "^2.2.1",
    "canvas-confetti": "^1.9.4",
    "lenis": "^1.3.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.31.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/compiler-sfc": "^3.5.30",
    "sass": "^1.98.0",
    "sharp": "^0.35.3",
    "vite": "^6.4.1",
    "wrangler": "^4.80.0"
  }
}
